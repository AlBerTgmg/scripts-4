$uri = [Uri]"https://login.microsoftonline.com"
$p = [System.Net.WebRequest]::GetSystemWebProxy().GetProxy($uri)
$p




Test-NetConnection login.microsoftonline.com -Port 443 -InformationLevel Detailed
Test-NetConnection activation.sls.microsoft.com -Port 443 -InformationLevel Detailed
Test-NetConnection officecdn.microsoft.com -Port 443 -InformationLevel Detailed
Test-NetConnection officeclient.microsoft.com -Port 443 -InformationLevel Detailed




$urls = @(
    "https://login.microsoftonline.com/",
    "https://activation.sls.microsoft.com/",
    "https://officecdn.microsoft.com/",
    "https://officeclient.microsoft.com/"
)

foreach ($url in $urls) {
    Write-Host "`n$url" -ForegroundColor Cyan

    try {
        $r = Invoke-WebRequest $url -UseBasicParsing -TimeoutSec 30
        Write-Host "OK - HTTP $($r.StatusCode)" -ForegroundColor Green
    }
    catch {
        if ($_.Exception.Response) {
            Write-Host "CONECTIVIDAD OK - HTTP $([int]$_.Exception.Response.StatusCode)" -ForegroundColor Yellow
        }
        else {
            Write-Host "FALLO DE CONECTIVIDAD: $($_.Exception.Message)" -ForegroundColor Red
        }
    }
}




