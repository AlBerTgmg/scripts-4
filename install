[CmdletBinding()]
param( [String]$CallParam )
######################################################################################
# Application Info (REQUIRED)                                                        #
######################################################################################
$APP_Company         = "Microsoft"
$APP_Name            = "Office_365_ProPlus_PT_BR_ES_EN_FR_DE"
$APP_Version         = "16.0.20326.20142"
$APP_Architecture    = "X64"
$APP_System          = "01"
$APP_Language        = "ML"
$APP_InternalVersion = "01.00"
$APP_GENE_NAME = ($($APP_Company) + "_" + $($APP_Name))
if ($APP_Company -eq ""){$APP_GENE_NAME = $APP_Name}
$Clave_Reg = "NO"
$IPL = "NO"
######################################################################################
# Deployment Info (REQUIRED)                                                         #
######################################################################################
#
# @ DETECTION METHOD
#      Type
#            File System
#                File: 
#                Version: 
#                Date: 
#            Registry: 
#            Windows Installer: 
#            Script: 
#
# @ USER EXPERIENCE
#      Installation behavior
#            Install for system: 
#            Install for user: 
#      Logon Requirement
#            Only when a user is logged on: 
#            Whether or not a user is logged on: 
#            Only when no user is logged on: 
#      Installation Program Visibility
#            Normal: 
#            Hidden: 
#
# @ DEPENDENCIES:
# 
# 
#
# @ COMMENTS:
# 
#
#
######################################################################################


##################################################################################################################
#                                                                                                                #
#                                          DO NOT MODIFY BELOW THIS LINE                                         #
#                                                                                                                #
##################################################################################################################

######################################################################################
# VARIABLES             															 # 
######################################################################################
	
$PathScript  = split-path -parent $MyInvocation.MyCommand.Definition
$PathProg    = $PathScript + "\prog"
$PathLog = "C:\logs\"
$ExitCode = $null
$Sep          = '_'
$Package      = "$APP_GENE_NAME$Sep$APP_Version$Sep$APP_Architecture$Sep$APP_System$Sep$APP_Language"
#$Package     = $APP_GENE_NAME  # generic log name without version 
 if ($CallParam -eq 'TEST'){$ErrorActionPreference = 'Stop'}
 else{$ErrorActionPreference = 'Continue'}
$DateStartScript = get-date -Format 'HH:mm:ss'
$logfile = $PathLog + $Package + ".log"
$AllUserDesktop = [Environment]::GetFolderPath("CommonDesktopDirectory") # All user desktop
$AllUserPrograms =[Environment]::GetFolderPath("CommonPrograms") # Start Menu for All user
$ProgramData    = (Get-Item env:ALLUSERSPROFILE).value
$Windir         = $env:windir
$RebootNeeded   = $false

######################################################################################
# Get Computer Info                                                                  # 
######################################################################################

$ComputerInfo=Get-CimInstance Win32_OperatingSystem | Select Caption, Version, OSArchitecture 
$ComputerUser = Get-WMIObject -class Win32_ComputerSystem | Select Domain,Model,Username
$ComputerLanguage = Get-Culture
$LauncherUser =[System.Security.Principal.WindowsIdentity]::GetCurrent().Name
$Hostname= $env:computername
$OperatingSystem = $ComputerInfo.Caption
$VersionOS = $ComputerInfo.Version
$ArchitectureOs = $ComputerInfo.OSArchitecture
$LanguageOS = $ComputerLanguage.DisplayName
$Domain = $ComputerUser.Domain
$Model = $ComputerUser.Model
$User = $ComputerUser.UserName


######################################################################################
# Determine Folder-Architecture                                                      # 
######################################################################################

if ($APP_Architecture -eq 'X86')
    {
    $BitsOs = 32
    $ProgFiles = $env:ProgramFiles
    $SystemFiles = "$Windir\SYSTEM32"

    }
elseif ($APP_Architecture -eq 'X64')
    {
    $BitsOs = 64
	$ProgFiles86 = ${env:ProgramFiles(x86)}
    $ProgFiles = $env:ProgramFiles
    $SystemFiles = "$Windir\SYSTEM32"
    }
elseif ($APP_Architecture -eq 'ALL')   
    {
	if ($ArchitectureOs -match '64')
        {
        $BitsOs = 64         
		$ProgFiles86 = ${env:ProgramFiles(x86)}
        }
    else
        {
        $BitsOs = 32
        }
    $ProgFiles = $env:ProgramFiles
    $SystemFiles = "$Windir\SYSTEM32"
    }
elseif ($APP_Architecture -eq 'WOW')
    {
  
     if ($ArchitectureOs -like '*64*')
        {
        $BitsOs = 64       
        $ProgFiles = ${env:ProgramFiles(x86)}
		$ProgFiles64 = $env:ProgramFiles
        $SystemFiles = "$Windir\SYSWOW64"
        }
    else
        {
        $BitsOs = 32
        $ProgFiles = $env:ProgramFiles
        $SystemFiles = "$Windir\SYSTEM32"
        }
    }


######################################################################################
# Function Param "NEW"                                                               # 
######################################################################################

If ($CallParam -eq "NEW")
{
New-Item -Name $Package -ItemType "directory"
New-Item -Name "$Package\Prog" -ItemType "directory"
Copy-Item .\Install.ps1 -Destination $Package
Copy-Item .\Uninstall.ps1 -Destination $Package
Exit 0
}


######################################################################################
# Function Create-LogFile                                                            # 
######################################################################################
                             
function Create-LogFile
{
 $DateTime  = Get-Date -Format 'HH:mm:ss' 
 $DateTime2 = Get-Date -Format 'dd/MM/yyyy'
 Add-Content -Value "$DateTime -----------------------------------------------------------------------------------" -Path $logfile
 Add-Content -Value "$DateTime $Package " -Path $logfile
 switch ($CallParam) {
	"TEST"	{Add-Content -Value "$DateTime Internal Version: $APP_InternalVersion           TEST MODE : ON" -Path $logfile}
	"/A"	{Add-Content -Value "$DateTime Internal Version: $APP_InternalVersion			INSTALL MODE ARRANQUE!!!" -Path $logfile}	
	default {Add-Content -Value "$DateTime Internal Version: $APP_InternalVersion" -Path $logfile}
 }
 Add-Content -Value "$DateTime -----------------------------------------------------------------------------------" -Path $logfile
 Add-Content -Value "$DateTime <<<< Start $DateTime2    $DateTime >>>>>" -Path $logfile
 Add-Content -Value "$DateTime" -Path $logfile
 Add-Content -Value "$DateTime O.S.                : $OperatingSystem - $ArchitectureOs" -Path $logfile
 Add-Content -Value "$DateTime O.S. Language       : $LanguageOS" -Path $logfile
 Add-Content -Value "$DateTime O.S. Version        : $VersionOS" -Path $logfile
 Add-Content -Value "$DateTime Hostname            : $Hostname" -Path $logfile 
 Add-Content -Value "$DateTime User                : $User" -Path $logfile
 Add-Content -Value "$DateTime Domain              : $Domain" -Path $logfile
 Add-Content -Value "$DateTime Install User        : $LauncherUser" -Path $logfile
 Add-Content -Value "$DateTime Install Path        : $PathScript" -Path $logfile
 Add-Content -Value "$DateTime System Enviroment $BitsOs" -Path $logfile
 Add-Content -Value "$DateTime" -Path $logfile
}


######################################################################################
# Function Finish-LogFile                                                            # 
######################################################################################
                             
function Finish-LogFile
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       $CodeExit
     )
 
If ($Clave_Reg -eq "SI"){
   switch ($CodeExit) {
	0 {
	Claves-Registro	
	}
	3010 {
    Claves-Registro
	}
	4884 {
	#return 0
	#$ExitCode = 0
	$CodeExit = 0
	}
	default {    
	}
   }
}
	 
 $DateTime  = Get-Date -Format 'HH:mm:ss' 
 $DateTime2 = Get-Date -Format 'dd/MM/yyyy' 
 $DateEndScript = get-date -Format 'HH:mm:ss'
 $Executiontime = New-TimeSpan -Start $DateStartScript -End $DateEndScript
 Add-Content -Value "$DateTime Application Version: $APP_Version" -Path $logfile
 Add-Content -Value "$DateTime" -Path $logfile
 Add-Content -Value "$DateTime Finalize. Return value: $CodeExit" -Path $logfile
 Add-Content -Value "$DateTime Execution Time: $Executiontime" -Path $logfile
 Add-Content -Value "$DateTime <<<< Finish  $DateTime2    $DateTime >>>>>" -Path $logfile
 Add-Content -Value "$DateTime -----------------------------------------------------------------------------------" -Path $LogFile
 Add-Content -Value " " -Path $logfile
 Add-Content -Value " " -Path $logfile
 if ($CallParam -eq 'TEST')
	{Write-Output "Output [$CodeExit]"
    Break Script
    }
 else
    {[Environment]::Exit($CodeExit)}
 }
######################################################################################
# Function Claves-Registro                                                           # 
######################################################################################
 
function Claves-Registro
{
 $DateTime = Get-Date -Format 'HH:mm:ss'
 $DateTime2 = Get-Date -Format 'dd/MM/yyyy'
 $APP_REG =   $APP_GENE_NAME
 $APP_REG2 = ($APP_GENE_NAME + "_DESINST")
 $APP_REG_DESC = ""
 if (Test-Path -Path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)"){Remove-Item -Path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)" -Recurse} 
 if (Test-Path -Path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG2)"){Remove-Item -Path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG2)" -Recurse} 
 New-Item -Path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)"
 New-ItemProperty -path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)" -propertyType String -Name Version -value "$($APP_InternalVersion)"
 New-ItemProperty -path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)" -propertyType String -Name "Manufacturer Version" -value "$($APP_Version)"
 New-ItemProperty -path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)" -propertyType String -Name Date -value "$($DateTime2) $($datetime)"
 New-ItemProperty -path "HKLM:\SOFTWARE\WOW6432Node\Paquetes\$($APP_REG)" -propertyType String -Name Description -value "$($APP_REG)_$($APP_Version)_$($APP_Architecture)_$($APP_System )_Vi$($APP_InternalVersion)_$($APP_Language)"
 }
 
######################################################################################
# Function F-ARRANQUE                                                          		 # 
######################################################################################
Function F-ARRANQUE
{
      #$APP_Version -replace ".","_"
	  $DateTime  = Get-Date -Format 'HH:mm:ss' 
	  $DateTime2 = Get-Date
	  $APP_VERALM1 = $APP_Version.SubString(0,2)
	  $APP_VERALM2 = $APP_Version.SubString(3,2)
	  $APP_VERALM = "$($APP_VERALM1)_$($APP_VERALM2)"
	  $Folder_Arry = @(	"C:\SAN\PAQUETES",
						"C:\SAN\PAQUETES\ALM",
						"C:\SAN\PAQUETES\ERR", 
						"C:\SAN\PAQUETES\EXE", 
						"C:\SAN\PAQUETES\MVD",
						"C:\SAN\PAQUETES\TMP")
		foreach ($Folder in $Folder_Arry){
		if (-not (New-Object -ComObject Scripting.FileSystemObject).FolderExists("$Folder")){
			New-Item -Path "$Folder" -ItemType Directory}
		else{	
		}
		}
	  Remove-Item -Path "C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)*" -force -recurse
	  Start-Sleep -s 3
	  Write-ALM ("STARTING COPY = $LauncherUser $DateTime2 $Hostname") 0
	  Write-Log ("STARTING COPY = $LauncherUser $DateTime2 $Hostname") 0
	  New-Item -Path "C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)" -ItemType Directory
		if ((New-Object -ComObject Scripting.FileSystemObject).FolderExists("$Folder")){
		Copy-Item "Install.ps1" -Destination "C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)\Install.ps1" -Recurse -Force -Passthru
		Copy-Item -Path "$PathProg" -Destination "C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)" -Recurse -Force -Passthru
		 if ((New-Object -ComObject Scripting.FileSystemObject).FolderExists("C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)\PROG") -and (New-Object -ComObject Scripting.FileSystemObject).FileExists("C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)\Install.ps1")){	
		 Write-ALM ("LOAD C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM) OK") 0
		 Write-Log ("LOAD C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM) OK") 0
		 }
		else{	
		Write-ALM ("LOAD C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM) KO") 8899
		Write-Log ("LOAD C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM) KO") 8899
		Finish-LogFile 8899
		}
	  }
	   $PXML = "C:\SAN\PAQUETES\ALM\$($APP_GENE_NAME)_$($APP_VERALM)\Prog\Instalar.dsh.xml"
	   Add-Content -Value "<?xml version=""1.0"" encoding=""utf-8""?>" -Path $PXML
	   Add-Content -Value "<DATSOF>" -Path $PXML
	   Add-Content -Value "  <APLI>" -Path $PXML
	   Add-Content -Value "    <NOMBRE>$APP_GENE_NAME</NOMBRE>" -Path $PXML
	   Add-Content -Value "    <DESC>$($APP_GENE_NAME)_$($APP_VERALM)</DESC>" -Path $PXML
	   Add-Content -Value "    <VERAPLI>$APP_Version</VERAPLI>" -Path $PXML
	   Add-Content -Value "    <VERDIS>$APP_Verdis</VERDIS>" -Path $PXML
	   Add-Content -Value "    <BITS_APPL>32/64</BITS_APPL>" -Path $PXML
	   Add-Content -Value "    <IPL>$IPL</IPL>" -Path $PXML
	   Add-Content -Value "    <TIPOINS>AR</TIPOINS>" -Path $PXML
	   Add-Content -Value "    <PROCINS>install.ps1</PROCINS>" -Path $PXML
	   Add-Content -Value "    <LOGFILE></LOGFILE>" -Path $PXML
	   Add-Content -Value "  </APLI>" -Path $PXML
	   Add-Content -Value "</DATSOF>" -Path $PXML
	  Write-Log "ARRANQUE MODULE COMPLETED" 0
	  #return 4884  
	  #$ExitCode = 4884
	  Finish-LogFile 4884
}
 
######################################################################################
# Function Format-Rc                                                                  # 
######################################################################################

Function Format-Rc 
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [string]$Rcprm
     )
$Length = $Rcprm.Length

if ($Length -eq 0)
    {return "NULL"}

elseif ($Length -eq 1)
    {return "000$Rcprm"}

elseif ($Length -eq 2)
    {return "00$Rcprm"}

elseif ($Length -eq 3)
    {return "0$Rcprm"}

else
    {return "$Rcprm"}
}



######################################################################################
# Function Message-User ( EX. Message-User "text spanish" "text english" )           # 
######################################################################################

Function Message-User 
{ Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$MessageSp,
     [Parameter(Mandatory=$true, Position=1)]
       [STRING]$MessageEn
     )

# DON'T SHOW IF THE SCRIPT WAS LAUNCHED WITH 'P' ## .\INSTALL.PS1 P

if ($CallParam -ne 'P')
    {
    # Load assembly
    Add-Type -AssemblyName Microsoft.VisualBasic
    $res=[Microsoft.VisualBasic.Interaction]::MsgBox("$MessageSp`n`n$MessageEn", 'OkCancel,systemmodal,Information', 'Atenci n / Attention')
    if ($res -eq 'Cancel')
       {
        Write-Log "User cancel install" 9999
        Finish-LogFile 9999       
       }
    }
}
##################################################################################################################
#       F-CARTEL "PROCESS" "1" "0"                                                                               #
#       PROCESS -->process name                                                                                  #
#       First parameter: "0" close the process directly "1" Shows the cartel                                     #
#       Second parameter: "0" PUT THE NAME OF THE APP "CUSTOM NAME"                                              #
##################################################################################################################
Function F-CARTEL 
{ 
Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Proceso,
     [Parameter(Mandatory=$true, Position=1)]
       [STRING]$Todo,
	 [Parameter(Mandatory=$true, Position=2)]
       [STRING]$Mensa2
     )
	if (!(Test-Path -Path "c:\san\Scripts\Cartel.exe" -PathType Leaf)) {$Todo = 0}
	if ($Mensa2 -eq "0"){$Mensa = $APP_Name}
	else {$Mensa = $Mensa2}
	for ($i = 0; $i -le 40; $i ++ )
	  {
	  	if ($Todo -eq 0){
	    Close-Process $Proceso
		$i = 40
		}
		if ($Todo -eq 1)
		{
		 if((get-process $Proceso -ErrorAction SilentlyContinue) -eq $Null)
		 {
			Close-Process $Proceso
			$Todo= 0
		 }
		 else { 
			$Exis0 = (New-Object -ComObject WScript.Shell).RegWrite("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\APP","$Mensa","REG_SZ")
			$Exis0 = (New-Object -ComObject WScript.Shell).RegWrite("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\Version","$APP_Version","REG_SZ")
			$Exis0 = (New-Object -ComObject WScript.Shell).RegWrite("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\Control","1","REG_SZ")
				  for ($j = 0; $j -le 30; $j ++ )
				  {
					$Exis0 = (New-Object -ComObject WScript.Shell).RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\Control") 
					if ($Exis0 -eq "1"){
						Start-Sleep -s 2						
					}					
					else {
						Write-Log "PROCESS $Process CLOSED BY THE USER THE INSTALLATION CONTINUES $Proceso" 0
						$Exis0 = (New-Object -ComObject WScript.Shell).RegWrite("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\Control","0","REG_SZ")
						$Todo= 0
						break
					}
				  
				  
				  }
		 }
		}
	  }	
	  $Exis0 = (New-Object -ComObject WScript.Shell).RegWrite("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Paquetes\MENSA\Control","0","REG_SZ")
}

######################################################################################
# Function Write-Log ( EX. Write-Log "text" 22 )    (the number is optional)         # 
######################################################################################

function Write-Log 
{ 	
Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Message,
     [Parameter(Mandatory=$false, Position=1)]
       $RetEndEL
     )
    
    if ($RetEndEL -eq $null){
        $DateTime = Get-Date -Format  HH:mm:ss  
        Add-Content -Value "$DateTime [Rc=NULL] -- $Message" -Path $logfile
    }
    Else{   
	    $RetEndClmp = Format-Rc ($RetEndEL).ToString()
        $DateTime = Get-Date -Format  HH:mm:ss  
        Add-Content -Value "$DateTime [Rc=$RetEndClmp] -- $Message" -Path $logfile
    }
}
######################################################################################
# Function Write-ALM  														         # 
######################################################################################
