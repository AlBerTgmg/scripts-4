    }
}


######################################################################################
# Function Extract-Zip ( EX. Extract-Zip "$PathProg\file.zip" "C:\temp" )            # 
######################################################################################

Function Extract-Zip
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$ZipFile,
     [Parameter(Mandatory=$true, Position=1)]
       [STRING]$DestinationFolder
     )

   if (Test-Path -path $ZipFile)
    {
      try
        {
        $FmZip = Get-Item $ZipFile
        $error.Clear()
        Expand-Archive -LiteralPath $ZipFile -DestinationPath $DestinationFolder -Force 
		$ZipName = $FmZip.Name
        If ($error.Count -eq 0)
            {
            Write-Log "Extract Zip $ZipFile in $DestinationFolder - OK" 0
            return 0
            }
        else
            {
            if ($error[0].hresult -eq $null)
            {$ERREXIT=999}
            else
            {$ERREXIT=$error[0].hresult}
		    Write-Log "Extract Zip $ZipFile - KO" $ERREXIT
            return $ERREXIT
            }
        }
      Catch 
        {
            if ($error[0].hresult -eq $null)
            {$ERREXIT=999}
            else
            {$ERREXIT=$error[0].hresult}

        Write-Log "Extract Zip $ZipName - KO" $ERREXIT
        return $ERREXIT
        }
    }
  else
    {
      Write-Log "$ZipFile not found - KO" 2
      return 2
    }

}


######################################################################################
# Function Firewall-Rules ( EX. Firewall-Rules ("$ProgFiles\App\App.exe") )          # 
######################################################################################

function Firewall-Rules
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Program
     )


$FicheroRF = Get-Item $Program
$ProgramaNameRF =$FicheroRF.name
try
     {
      New-NetFirewallRule -DisplayName "$ProgramaNameRF TCP" -Direction Inbound -Program $Program -Protocol TCP -Action Allow -Profile Domain, Private -Enabled True
      New-NetFirewallRule -DisplayName "$ProgramaNameRF UDP" -Direction Inbound -Program $Program -Protocol UDP -Action Allow -Profile Domain, Private -Enabled True
      Write-Log "Firewall Rule TCP/UDP $Program correctly applied" 0
      return 0
     }
catch
     {
     if ($error[0].hresult -eq $null)
     {$ERREXIT=999}
     else
     {$ERREXIT=$error[0].hresult}    
     Write-Log "Firewall Rules TCP/UDP $Program - KO" $ERREXIT
     Finish-LogFile $ERREXIT
     }
}


######################################################################################
# Function Remove-Folder ( EX. Remove-Folder ("$ProgFiles\App\App.exe") )            # 
######################################################################################

function Remove-Folder
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Folder
     )
if (Test-Path -path $Folder)
    {try 
        {               
        
        $error.Clear()
        Write-Log "Remove-Item -Path $Folder -Recurse -Force" 0
        Remove-Item -Path $Folder -Recurse -Force

        
        If ($error.Count -eq 0)
            {
            Write-Log "Remove  $Folder - OK" 0
            return 0
            }
        else
            {
            $Erstr= $Error[0].ErrorDetails.Message
		    Write-Log "Remove $Folder - KO - $Erstr" 1            
            return 1
            }
        }
    Catch
        {
        if ($error[0].hresult -eq $null)
        {$ERREXIT=999}
        else
        {$ERREXIT=$error[0].hresult}        
        Write-Log "Remove $Folder - KO" $ERREXIT
        return $ERREXIT
        }           
     }   
else
    {
    Write-Log "$Folder not found" 0
    return 0
    }
}


#######################################################################################
# Function Permissions-Folder ( EX. Permissions-Folder ("$ProgFiles\AppFolder") )      # 
#######################################################################################

function Permissions-Folder
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Folder
     )


if (Test-Path -path $Folder)
    {
    try
        { 
        $user = New-Object -TypeName 'System.Security.Principal.SecurityIdentifier' -ArgumentList @([System.Security.Principal.WellKnownSidType]::AuthenticatedUserSid, $null)
        $inherit = [system.security.accesscontrol.InheritanceFlags]"ContainerInherit, ObjectInherit"
        $propagation = [system.security.accesscontrol.PropagationFlags]"None"
        $acl = Get-Acl $Folder
        $accessrule = New-Object system.security.AccessControl.FileSystemAccessRule($user, "FullControl", $inherit, $propagation, "Allow")
        $acl.AddAccessRule($accessrule)
        set-acl -aclobject $acl $Folder
        Get-Acl $Folder | fl
        Write-Log "Set Folder permissions to $Folder Domain Users" 0
		$ExeFile = "c:\windows\system32\icacls.exe"
		$Param = """$Folder"" /T /C /grant *S-1-5-32-545:(OI)(CI)F"  
		$Res=Start-Process "$ExeFile" -ArgumentList $Param -Wait -NoNewWindow -PassThru 
        Write-Log "RESULTADO: $APP_GENE_NAME" $res.ExitCode 
        If ($Res.ExitCode -eq 3010){
            $Global:RebootNeeded = $true
            $Res.ExitCode = 0
        }
		If ($Res.ExitCode -ne 0){Write-Log $Res.ExitCode}
        If ($Text -eq ""){
            Write-Log "Set Folder permissions to $Folder Local Users OK" 0
        }
        return 0
       }
    Catch
        {
        if ($error[0].hresult -eq $null)
        {$ERREXIT=999}
        else
        {$ERREXIT=$error[0].hresult}
        
        Write-Log "Folder permissions error to $Folder" $ERREXIT
        Finish-LogFile $ERREXIT
        }
    }
}


######################################################################################
# Function Close-Process ( EX. Close-Process "Notepad" )                             # 
######################################################################################

function Close-Process
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$Proceso
     )
    if((get-process $Proceso -ErrorAction SilentlyContinue) -eq $Null){}
	Else{
		try
		{
		Stop-Process -Name $Proceso -Force
		Write-Log "Stop process $Proceso" 0
		return 0
		}
		catch
		{
		if ($error[0].hresult -eq $null){$ERREXIT=999}
		else{$ERREXIT=$error[0].hresult}
		Write-Log "Stop Proccess $proceso Error" $ERREXIT
		return $ERREXIT
		}
	}	
}


###############################################################################################
# Function MSI-Run-Uninstall ( EX. MSI-Run-Uninstall "72C7A21B-9CB0-40D3-B04F-987F6821C7C5" ) # 
###############################################################################################

Function MSI-Run-Uninstall
{
 Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$ProductCode,
	 [Parameter(Mandatory=$false, Position=1)]
       [STRING]$Muestro
     )
    if ($Muestro -eq "1"){Write-Log "Searching product code..." 0}
    $Uninstall_Keys = "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall","HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"
    $Busqueda = @()
    foreach ($U_Key in $Uninstall_Keys) 
        {
        foreach ($Item in $ProductCode) { $busqueda += get-childitem -recurse $U_Key | get-itemproperty | where { $_.UninstallString -match $Item } }
        }
    if (!($Busqueda)) 
        { 
        if ($Muestro -eq "1"){Write-log "$ProductCode : Not installed" 0}
        return 0
        }
    else
    {
            $name= ($Busqueda|select displayname).displayname
            $msilog= "c:\logs\Uninst-$name.log"
            
            $parametros=' /x {'+$ProductCode+'} /qn /L*v '+"""$msilog"""
            Write-Log "Running command for uninstallation..." 0
            Write-Log "Run msiexec.exe $parametros" 0
            $Res=Start-Process "Msiexec" -ArgumentList $Parametros -Wait -NoNewWindow -PassThru
		    If ($Res.ExitCode -eq 3010){
                $Global:RebootNeeded = $true
                return 0
            }
		    If ($Res.ExitCode -ne 0){Finish-LogFile $Res.ExitCode}
            Write-Log "Uninstall $namemsi - OK" 0
            return 0
    }
}


######################################################################################
# Function MSI-Run ( EX. MSI-Run "PathProg\AppMSI.msi" )                             # 
######################################################################################

Function MSI-Run
{
Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$MsiFile
     )

  if (Test-Path -path $MsiFile)
    {
      try
        {

        $Fmsi = Get-Item $MsiFile
        $msilogFile = $PathLog+$Fmsi.name+'.log'
        $namemsi = $Fmsi.Name
        $MSIArguments = @(
            "/i"
            ('"{0}"' -f $MsiFile)
            "/qn"
            "ALLUSERS=1"
            "REINSTALLMODE=omus"
            "/norestart"
            "/L*v"
            """$msilogFile"""
            )
        Write-Log "Running command for installation..." 0
        Write-Log "Run msiexec.exe $MSIArguments" 0
        $Res=Start-Process "msiexec.exe" -ArgumentList $MSIArguments -Wait -NoNewWindow -PassThru
        If ($Res.ExitCode -eq 3010){
            $Global:RebootNeeded = $true
            return 0
        }
		If ($Res.ExitCode -ne 0)
            {
            if ($res.ExitCode -eq 1618)
                {
                Start-Sleep -Seconds 60
                $Res=Start-Process "msiexec.exe" -ArgumentList $MSIArguments -Wait -NoNewWindow -PassThru
                If ($Res.ExitCode -eq 3010)
                    {
                    $Global:RebootNeeded = $true
                    return 0
                    }
                If ($res.ExitCode -ne 0){Finish-LogFile $Res.ExitCode}
                }
            else {Finish-LogFile $Res.ExitCode}
            }
        Write-Log "Install $namemsi - OK" 0
        return 0
        }
      Catch 
        {
        if ($error[0].hresult -eq $null)
        {$ERREXIT=999}
        else
        {$ERREXIT=$error[0].hresult}
        Write-Log "Install $namemsi - KO" $ERREXIT
        Finish-LogFile $ERREXIT
        }
    }
  else
    {
      Write-Log "$MsiFile not found - KO" 8888
      Finish-LogFile 8888
    }
    
}


##############################################################################################################################################
# Function EXE-Run ( EX. EXE-Run "$Pathprog\C24iO_windows-x64_4_12_6.exe" "-q -varfile ""$PathProg\response.varfile""" "TEXT-LOG"(optional) )  # 
##############################################################################################################################################

Function EXE-Run
{
Param
    ([Parameter(Mandatory=$true, Position=0)]
       [STRING]$ExeFile,
     [Parameter(Mandatory=$true, Position=1)]
       [STRING]$Param,
     [Parameter(Mandatory=$false, Position=2)]
       [STRING]$Text
     )
        
   if (Test-Path -path $ExeFile)
    {
      try
        {
        $FmExe = Get-Item $ExeFile
        Write-Log "Run $ExeFile $Param" 0
        $Res=Start-Process "$ExeFile" -ArgumentList $Param -Wait -NoNewWindow -PassThru 
        If ($Res.ExitCode -eq 3010){
            $Global:RebootNeeded = $true
            return 0
        }
		If ($Res.ExitCode -ne 0){Finish-LogFile $Res.ExitCode}
        If ($Text -eq ""){
            Write-Log "$FmExe has been executed correctly - OK" 0
        }
        Else{
            Write-Log "$Text has been executed correctly - OK" 0
        }
        return 0
		
        }
      Catch 
        {
        if ($error[0].hresult -eq $null)
        {$ERREXIT=999}
        else
        {$ERREXIT=$error[0].hresult}

        If($Text -eq ""){Write-Log "$ExeFile $Param" $ERREXIT}
        Else{Write-Log "$Text" $ERREXIT}
        
        Finish-LogFile $ERREXIT
        }
    }
  else
    {
      Write-Log "$ExeFile not found - KO" 8888
      Finish-LogFile 8888
    }
    
}


Create-LogFile

