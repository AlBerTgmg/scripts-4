$origen = 'C:\Users\ADMCYA~1\AppData\Local\Temp\Office-AP59-20260914-105404.txt'
$salida = Join-Path (Split-Path $origen) 'Office-AP59-resultados.txt'

Select-String -LiteralPath $origen -Pattern 'created by InternetConnect|created by HttpOpenRequest|HTTP response \(|SSL negotiation|TCP connection to server|request.*failed|request.*error|error.*request' |
    Where-Object { $_.Line -notmatch 'Headers|Cookie|Authorization' } |
    Select-Object -First 400 |
    ForEach-Object { '{0}: {1}' -f $_.LineNumber, $_.Line } |
    Set-Content -LiteralPath $salida -Encoding UTF8

notepad.exe $salida
