$origen = 'C:\Users\ADMCYA~1\AppData\Local\Temp\Office-AP59-20260914-105404.txt'
$salida = Join-Path (Split-Path $origen) 'Office-AP59-WebIO.txt'

Select-String -LiteralPath $origen -Pattern 'Microsoft-Windows-WebIO' |
    Where-Object {
        $_.Line -match 'Url|Uri|Host|Server|Proxy|Status|Response|Error|Connect' -and
        $_.Line -notmatch 'Headers|Cookie|Authorization|Set Request Option|Entity|DataChunk|Buffer'
    } |
    Select-Object -First 200 |
    ForEach-Object {
        '{0}: {1}' -f $_.LineNumber, $_.Line
    } |
    Set-Content -LiteralPath $salida -Encoding UTF8

notepad.exe $salida
