$proxyAuto = [System.Net.WebRequest]::GetSystemWebProxy()

foreach ($destino in @(
    'https://login.microsoftonline.com',
    'https://activation.sls.microsoft.com',
    'http://www.msftconnecttest.com/connecttest.txt'
)) {
    $uri = [uri]$destino
    $proxyElegido = $proxyAuto.GetProxy($uri)

    Write-Host "`nDestino: $destino"
    Write-Host "Proxy: $proxyElegido"

    try {
        $r = Invoke-WebRequest -Uri $uri -Proxy $proxyElegido -ProxyUseDefaultCredentials -UseBasicParsing -TimeoutSec 30 -ErrorAction Stop
        Write-Host "HTTP:" $r.StatusCode

        if ($uri.Host -eq 'www.msftconnecttest.com') {
            Write-Host "Contenido:" $r.Content
        }
    }
    catch {
        Write-Host "Error:" $_.Exception.Message
    }
}
