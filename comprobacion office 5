$inicioPrueba = Get-Date

Get-WinEvent -ListLog 'Microsoft-Windows-AAD/Operational' |
    Format-List LogName, IsEnabled, RecordCount




Get-WinEvent -FilterHashtable @{
    LogName = 'Microsoft-Windows-AAD/Operational'
    StartTime = $inicioPrueba
} -ErrorAction Continue |
    Format-List TimeCreated, Id, Message

Get-WinEvent -FilterHashtable @{
    LogName = 'Application'
    StartTime = $inicioPrueba
} -ErrorAction Continue |
    Where-Object {
        $_.ProviderName -match 'Office|AppModel' -or
        $_.Message -match 'AAD.BrokerPlugin|TokenBroker'
    } |
    Select-Object -First 15 TimeCreated, ProviderName, Id, Message |
    Format-List



Get-WinEvent -LogName 'Microsoft-Windows-AAD/Operational' -MaxEvents 10 |
    Format-List TimeCreated, Id, Message







