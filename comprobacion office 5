hostname

Get-CimInstance Win32_OperatingSystem |
    Format-List Caption, Version, BuildNumber

$proxyAuto = [System.Net.WebRequest]::GetSystemWebProxy()

foreach ($destino in @(
    'https://login.microsoftonline.com',
    'https://activation.sls.microsoft.com',
    'http://www.msftconnecttest.com/connecttest.txt'
)) {
    $uri = [uri]$destino
    Write-Host "`nDestino: $destino"
    Write-Host "Proxy elegido:" $proxyAuto.GetProxy($uri).AbsoluteUri
    Write-Host "Sin proxy:" $proxyAuto.IsBypassed($uri)
}





